# Copy this file to etl/.env and fill in local values.
IGEM_DB_HOST=localhost
IGEM_DB_PORT=3306
IGEM_DB_USER=root
IGEM_DB_PASSWORD=
IGEM_DB_NAME=igem_terpene

# Leave empty to use the repository root's for_* data directories.
# Set an absolute path only when your TSV data lives elsewhere.
IGEM_DATA_DIR=
